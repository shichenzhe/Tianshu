# compiled output
/dist
/node_modules
/build

# standalone 产物目录（PK-T3：dist+node_modules+prisma+package.json 独立拷贝）
/standalone

# SDK 生成产物（SK-1：sdk:export/sdk:generate 按需重生，不入库）
/openapi.json
/sdk

# 脚手架初始化记录（npm run init 生成）
shu-init.json

# 本地数据库
prisma/local.db

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json


# 全局 gitignore 的 .* 规则会忽略模板需要的 dotfile，显式否定以保持模板自包含
!.prettierrc
!.dockerignore
!.github/
