{
  "compilerOptions": {
    "target": "ES2020",
    // lib 行为本分支新增：retrieval.ts 用 Intl.Segmenter，为其类型面加
    // ES2022.Intl（运行时 Node 16+/Chromium 内建，ES2020 emit 不受影响）；
    // DOM/DOM.Iterable 系跟随根 tsconfig 混配的保守选择（非实证必需——
    // expert-market 的 window 命中是字符串字面量，非 DOM 全局引用）
    "lib": ["ES2020", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@tianshu/protocol": ["../tianshu-protocol/dist/index.d.ts"],
      "@langchain/langgraph/prebuilt": [
        "../../node_modules/@langchain/langgraph/dist/prebuilt/index.d.ts"
      ]
    }
  },
  "include": ["src"]
}
