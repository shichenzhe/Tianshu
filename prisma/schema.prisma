generator client {
  provider = "prisma-client"
  output   = "../electron/generated/prisma"
}

datasource db {
  provider = "sqlite"
  relationMode = "prisma"
}

model user {
  id       Int     @id @default(autoincrement())
  username String  @unique(map: "user_username_index")
  password String
  email    String? @unique(map: "idx_user_email")
  nickname String?
}

model db_version {
  id      Int @id @default(autoincrement())
  version Int
}

model option {
  id    Int     @id @default(autoincrement())
  type  String
  name  String
  value String
  note  String?

  @@unique([type, name], map: "idx_option_type_name")
  @@index([type], map: "option_type_index")
}

model provider {
  id           Int      @id @default(autoincrement())
  name         String
  type         String
  baseUrl      String
  apiKey       String?
  extraHeaders String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model model {
  id            Int      @id @default(autoincrement())
  providerId    Int
  modelId       String
  name          String?
  enabled       Boolean  @default(true)
  temperature   Float?
  topP          Float?
  maxTokens     Int?
  contextWindow Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([providerId])
}

model assistant {
  id           Int      @id @default(autoincrement())
  name         String
  icon         String?
  systemPrompt String
  temperature  Float?
  topP         Float?
  maxTokens    Int?
  builtin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model workspace {
  id              Int       @id @default(autoincrement())
  name            String
  icon            String?
  directoryPath   String?
  defaultModelId  Int?
  writeApprovedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model session {
  id             Int       @id @default(autoincrement())
  workspaceId    Int
  assistantId    Int?
  currentModelId Int?
  title          String    @default("新会话")
  mode           String?
  pinnedAt       DateTime?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastMessageAt  DateTime?
}

model message {
  id          Int      @id @default(autoincrement())
  sessionId   Int
  role        String
  blocks      String
  modelId     Int?
  assistantId Int?
  error       String?
  createdAt   DateTime @default(now())

  @@index([sessionId])
}

model mcpServer {
  id        Int      @id @default(autoincrement())
  name      String
  transport String
  command   String?
  args      String?
  env       String?
  url       String?
  headers   String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model toolPermission {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  toolName    String
  createdAt   DateTime @default(now())

  @@unique([workspaceId, toolName], map: "idx_tool_permission_ws_tool")
}

model skillRecord {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String?
  version     String?
  source      String
  dir         String
  description String?
  enabled     Boolean  @default(true)
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
