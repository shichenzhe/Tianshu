{
  "compilerOptions": {
    "target": "ES2020",
    // lib 行为本分支新增：retrieval.ts 用 Intl.Segmenter，为其类型面加
    // ES2022.Intl（运行时 Node 16+/Chromium 内建，ES2020 emit 不受影响）；
    // DOM/DOM.Iterable 系跟随根 tsconfig 混配的保守选择（非实证必需——
    // expert-market 的 window 命中是字符串字面量，非 DOM 全局引用）
    "lib": ["ES2020", "ES2022.Intl", "DOM", "DOM.Iterable"],
    // 回退批 J 的 nodenext 迁移（c01236c9）：@langchain dual-package d.ts
    // 在 nodenext 的 import/require 双身份解析下 BaseRunManager 等同路径
    // 双类型互不派生——run-chat-stream 6 处协变崩（langchain 1.3.2/
    // 1.6.0 与源码自批 J 零变化，当时「零错」验证不实）。server
    // （commonjs）/desktop（bundler）单身份先例健康；emit 产物零差异
    // （nodenext 对无 type 字段包本就 CJS emit）。TS7 真移除 node10 时
    // 随桌面先例迁 bundler 或待生态 d.ts 修双身份，届时统一处置
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "5.0",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@tianshu/protocol": ["../tianshu-protocol/dist/index.d.ts"],
      "@langchain/langgraph/prebuilt": [
        "../../node_modules/@langchain/langgraph/dist/prebuilt/index.d.ts"
      ]
    }
  },
  "include": ["src"],
  // 包内同目录单测（如 relay-credential.test.ts）不进 dist（同
  // tianshu-protocol；vitest 侧由根 vitest.config include 直纳）
  "exclude": ["src/**/*.test.ts"]
}
