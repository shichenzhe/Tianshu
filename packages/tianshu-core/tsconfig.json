{
  "compilerOptions": {
    "target": "ES2020",
    // retrieval.ts 用 Intl.Segmenter（类型面在 ES2022.Intl——运行时为
    // Node 16+/Chromium 内建，ES2020 emit 不受影响）；DOM 系保留：
    // expert-market 静态数据源码引用 window/console 等（mirror 根 tsconfig
    // 的 ES2020+ES2022 混配 lib 同款处理）
    "lib": ["ES2020", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@tianshu/protocol": ["../tianshu-protocol/dist/index.d.ts"],
      "@langchain/langgraph/prebuilt": [
        "../../node_modules/@langchain/langgraph/dist/prebuilt/index.d.ts"
      ]
    }
  },
  "include": ["src"]
}
